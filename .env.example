# ==========================================
# OmniHub Production & Environment Config
# ==========================================

# 1. Master Passcode & Authentication Secret (Required for Single-User Protection)
# Used as master unlock passcode when deployed
ADMIN_PASSWORD="your-strong-master-passcode"

# A strong random 32+ char string used to sign session cookies
AUTH_SECRET="generate-a-super-secret-random-32-chars-key-here"

# 2. Database Connection
# For Local SQLite:
DATABASE_URL="file:./dev.db"
# For Vercel + Supabase PostgreSQL (Plan A):
# DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 3. Google Gemini AI Key (Speech-to-text & Natural Language Extraction)
# Can also be entered securely via Settings page in the UI
GEMINI_API_KEY=""

# 4. WhatsApp Cloud API Webhook Integration (Optional)
WHATSAPP_VERIFY_TOKEN="omnihub_secret_verify_token"
# Whitelist of allowed sender phone numbers (e.g. +60123456789,+6598765432)
ALLOWED_PHONE_NUMBERS=""
